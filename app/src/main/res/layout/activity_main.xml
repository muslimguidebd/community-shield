<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nestedScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0D1117"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- ══════════════════════════════════════════ -->
        <!--   HEADER — সব layer-এ দৃশ্যমান থাকে     -->
        <!-- ══════════════════════════════════════════ -->
        <!-- ══════════════════════════════════════════ -->
        <!--   HEADER — সব layer-এ দৃশ্যমান থাকে     -->
        <!-- ══════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardShieldContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:id="@+id/frameIconContainer"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_status_badge_amber">

                    <ImageView
                        android:id="@+id/ivShieldIcon"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_privacy_shield"
                        app:tint="#F59E0B" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Muslim Community Shield"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_status_badge_amber"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="● পারমিশন অপেক্ষমাণ"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Guardian Name (UID গোপন রেখে নাম দেখানো হবে) -->
                <TextView
                    android:id="@+id/tvGuardianName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#1810B981"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="#10B981"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvStatusDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="প্রথমে অথেন্টিকেশন সম্পন্ন করুন।"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <!-- Online Support & Tutorials Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenShieldSupport"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:text="ভিডিও গাইড ও অনলাইন সহায়তা"
                    android:textColor="#38BDF8"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_radar_rounded"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="#38BDF8" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════════════════════════════════ -->
        <!--   LAYER 1 — AUTH (card-free clean layout)  -->
        <!-- ══════════════════════════════════════════ -->
        <!-- ══════════════════════════════════════════ -->
        <!--   LAYER 1 — AUTH (Modern Dynamic Layout)   -->
        <!-- ══════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layerAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- ── CARD: স্ব-সুরক্ষা মোড (Hero Container for Self-Protection) ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMainAppAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#161B22"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="#3038BDF8"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="20dp">

                    <!-- Header Row: Icon + Title + Badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/frameMainAppIcon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_status_badge">

                            <ImageView
                                android:id="@+id/ivMainAppIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_privacy_shield"
                                app:tint="#10B981" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMainAppCardTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="স্ব-সুরক্ষা মোড"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="এই ডিভাইসের নিজস্ব সুরক্ষা"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvMainAppBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#2010B981"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="রেকমেন্ডেড"
                            android:textColor="#10B981"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Dynamic Subtitle -->
                    <TextView
                        android:id="@+id/tvMainAppSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="3dp"
                        android:text="আপনার ডিভাইসে মুসলিম গাইড অ্যাপ ইনস্টল রয়েছে। সরাসরি অ্যাকাউন্টের সাথে সিঙ্ক করুন।"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <!-- Primary Action 1: Auto Sync (When Main App is Installed) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAutoSyncMainApp"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="16dp"
                        android:text="অ্যাকাউন্টের সাথে এক-ক্লিকে সিঙ্ক"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="#059669"
                        app:cornerRadius="16dp"
                        app:elevation="4dp"
                        app:icon="@drawable/ic_radar_rounded"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconSize="20dp"
                        app:iconTint="#FFFFFF"
                        android:visibility="gone" />

                    <!-- Primary Action 2: Download Main App (When Main App is NOT Installed) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadMainAppAuth"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="16dp"
                        android:text="মূল মুসলিম গাইড অ্যাপ ডাউনলোড করুন"
                        android:textColor="#FFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="#2563EB"
                        app:cornerRadius="16dp"
                        app:elevation="4dp"
                        app:icon="@drawable/ic_download"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconSize="20dp"
                        app:iconTint="#FFFFFF"
                        android:visibility="visible" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── DIVIDER: অথবা বাচ্চার ডিভাইসের জন্য ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#20FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:text="অথবা বাচ্চার ডিভাইসের জন্য"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#20FFFFFF" />
            </LinearLayout>

            <!-- ── SECTION 2: কিউআর স্ক্যান / গ্যালারি আপলোড ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:paddingHorizontal="16dp"
                android:text="অভিভাবকের মুসলিম গাইড অ্যাপ থেকে কিউআর কোড স্ক্যান করে এই ডিভাইসে স্থায়ী নিরাপত্তা লিঙ্ক করুন"
                android:textColor="#94A3B8"
                android:textSize="12.5sp" />

            <!-- Scan QR Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanQr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="ক্যামেরা দিয়ে স্ক্যান করুন"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#0D38BDF8"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="20dp"
                app:iconTint="#38BDF8"
                app:strokeColor="#3538BDF8"
                app:strokeWidth="1.2dp" />

            <!-- Upload QR Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadQr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="গ্যালারি থেকে কিউআর ছবি নির্বাচন করুন"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#08FFFFFF"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_image_upload"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="18dp"
                app:iconTint="#94A3B8"
                app:strokeColor="#20FFFFFF"
                app:strokeWidth="1dp" />

        </LinearLayout>

        <!-- ══════════════════════════════════════════ -->
        <!--   LAYER 2 — ADB SETUP (uid আছে, DO নেই) -->
        <!-- ══════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layerAdbSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- প্লাগইন সক্রিয় করুন (Auto ADB) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAutoActivate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#059669"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_radar_rounded"
                            app:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="প্লাগইন সক্রিয় করুন"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="ট্যাপ করলে Wireless Debugging পেয়ারিং শুরু হবে"
                        android:textColor="#D1FAE5"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ম্যানুয়াল কানেক্ট (পোর্ট ও কোড) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FF161B22"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#1594A3B8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ম্যানুয়াল কানেক্ট (ঐচ্ছিক)"
                        android:textColor="#94A3B8"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            app:boxBackgroundColor="#0D1117"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#059669"
                            app:hintTextColor="#059669">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAdbPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="পোর্ট (যেমন: 42663)"
                                android:inputType="number"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:boxBackgroundColor="#0D1117"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#059669"
                            app:hintTextColor="#059669">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAdbPairingCode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="৬-সংখ্যার কোড"
                                android:inputType="number"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>

                    <!-- Manual Connect Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManualConnect"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:text="কানেক্ট করুন"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#059669"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_radar_rounded"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="#FFFFFF" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ৩-ধাপ নির্দেশিকা (Compact) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FF161B22"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1594A3B8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADB সংযোগ নির্দেশিকা"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Step 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_status_badge_amber"
                            android:gravity="center"
                            android:text="১"
                            android:textColor="#F59E0B"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Developer Options চালু করুন"
                                android:textColor="#E2E8F0"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Settings → About Phone → Build Number-এ ৭ বার ট্যাপ করুন"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="#15FFFFFF" />

                    <!-- Step 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_status_badge_amber"
                            android:gravity="center"
                            android:text="২"
                            android:textColor="#F59E0B"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wireless Debugging চালু করুন"
                                android:textColor="#E2E8F0"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Developer Options → Wireless Debugging → ON করুন"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="#15FFFFFF" />

                    <!-- Step 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_status_badge"
                            android:gravity="center"
                            android:text="৩"
                            android:textColor="#10B981"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="প্লাগইন সক্রিয় করুন"
                                android:textColor="#E2E8F0"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="উপরের সবুজ বাটনে ট্যাপ করুন → নোটিফিকেশনে আসা ৬-সংখ্যার কোড দিন"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Direct Developer Options Shortcut Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenDeveloperSettings"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:text="ডেভেলপার অপশন সেটিংস খুলুন"
                        android:textColor="#E2E8F0"
                        android:textSize="12.5sp"
                        app:cornerRadius="10dp"
                        app:strokeColor="#30FFFFFF"
                        app:icon="@drawable/ic_baseline_settings_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="#94A3B8" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ══════════════════════════════════════════ -->
        <!--   LAYER 3 — TERMINAL (ADB Active)         -->
        <!-- ══════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layerAdbTerminal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Connection Status -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0A10B981"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#3010B981"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_radar_rounded"
                        app:tint="#10B981" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="ADB সংযুক্ত — কমান্ড চালানো হচ্ছে..."
                        android:textColor="#10B981"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Terminal Output -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTerminalOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#0B0F14"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#3010B981"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_terminal"
                            app:tint="#10B981" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Terminal"
                            android:textColor="#10B981"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTerminalOutput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:text="$ প্রস্তুত..."
                        android:textColor="#A7F3D0"
                        android:textSize="11.5sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Copy PC Command -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCopyPcCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FF161B22"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#2594A3B8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_copy"
                            app:tint="#F59E0B" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="PC ADB কমান্ড কপি করুন"
                            android:textColor="#FFFFFF"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="কপি ➔"
                            android:textColor="#F59E0B"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#0D1117"
                        android:fontFamily="monospace"
                        android:padding="10dp"
                        android:text="adb shell dpm set-device-owner com.muslimguide.shield/.AdminReceiver"
                        android:textColor="#FDE68A"
                        android:textSize="11sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cancel / Retry Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelAdbTerminal"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="কানেকশন বাতিল / পুনরায় চেষ্টা"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="#50F59E0B"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="#F59E0B" />

        </LinearLayout>

        <!-- ══════════════════════════════════════════ -->
        <!--   LAYER 4 — PAIRED (Device Owner ✅)      -->
        <!-- ══════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/layerPaired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Success Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#0A10B981"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#4010B981"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="24dp"
                    android:paddingHorizontal="20dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_privacy_shield"
                        app:tint="#10B981" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="স্থায়ী সুরক্ষা সক্রিয়"
                        android:textColor="#10B981"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="ডিভাইস ওনার পারমিশন ও ১৮+ সুরক্ষা সক্রিয় রয়েছে।\nব্যাকগ্রাউন্ডে Shield সার্ভিস চলছে।"
                        android:textColor="#64748B"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hide Icon Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHideAppIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingVertical="14dp"
                android:text="অ্যাপ আইকন হাইড করুন"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#059669"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_eye_hide"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

            <!-- Open Main App -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenMainAppPaired"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingVertical="14dp"
                android:text="মুসলিমগাইড অ্যাপ খুলুন"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="16dp"
                app:strokeColor="#30FFFFFF" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>